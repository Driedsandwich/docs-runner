http_port 3128
visible_hostname docsrunner-egress
pid_filename /tmp/squid.pid
cache deny all
cache_store_log none
cache_log /dev/null
logfile_rotate 0
buffered_logs off
logformat denial DENIED %sn %Ss %>rd
acl rejected http_status 403
access_log stdio:/dev/stdout denial rejected
forwarded_for delete
via off
request_header_access Authorization deny all
request_header_access Proxy-Authorization deny all
request_header_access Cookie deny all
acl connect method CONNECT
acl safe_ports port 80 443
acl ssl_ports port 443
acl safe_method method GET HEAD CONNECT
acl allowed dstdomain -n @@DOMAINS@@
acl controller_dst dst @@CONTROL_IPS@@
acl nonpublic dst 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/3 ::/128 ::1/128 ::ffff:0:0/96 64:ff9b::/96 100::/64 2001::/23 2002::/16 fc00::/7 fe80::/10 ff00::/8
http_access deny manager
http_access deny !safe_ports
http_access deny connect !ssl_ports
http_access deny !safe_method
http_access deny !allowed
http_access deny controller_dst
http_access deny nonpublic
http_access allow allowed
http_access deny all
connect_timeout 5 seconds
request_timeout 15 seconds
read_timeout 30 seconds
client_lifetime 5 minutes
shutdown_lifetime 0 seconds
cache_mem 8 MB
maximum_object_size 0 KB

